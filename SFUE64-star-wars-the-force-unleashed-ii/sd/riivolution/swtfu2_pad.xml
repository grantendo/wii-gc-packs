<wiidisc version="1">
  <!-- Built by src/build.py: main.dol with a GameCube pad section.
       P1-P4 are the controller ports (adapter or console). -->
  <id game="SFUE"/>
  <options>
    <section name="Star Wars: The Force Unleashed II">
      <option name="GameCube controllers (Multiplayer, test)">
        <choice name="Enabled"><patch id="swtfu2_pad"/></choice>
      </option>
    </section>
    <section name="GameCube controllers: P1 (controller port 1)">
      <option name="P1: Tap jump" id="swtfu2_p1_tap" default="0">
        <choice name="On (also turns on the GameCube controllers)"><patch id="swtfu2_pad"/><patch id="swtfu2_tap1"/></choice>
      </option>
    </section>
    <section name="GameCube controllers: P2 (controller port 2)">
      <option name="P2: Tap jump" id="swtfu2_p2_tap" default="0">
        <choice name="On (also turns on the GameCube controllers)"><patch id="swtfu2_pad"/><patch id="swtfu2_tap2"/></choice>
      </option>
    </section>
    <section name="GameCube controllers: P3 (controller port 3)">
      <option name="P3: Tap jump" id="swtfu2_p3_tap" default="0">
        <choice name="On (also turns on the GameCube controllers)"><patch id="swtfu2_pad"/><patch id="swtfu2_tap3"/></choice>
      </option>
    </section>
    <section name="GameCube controllers: P4 (controller port 4)">
      <option name="P4: Tap jump" id="swtfu2_p4_tap" default="0">
        <choice name="On (also turns on the GameCube controllers)"><patch id="swtfu2_pad"/><patch id="swtfu2_tap4"/></choice>
      </option>
    </section>
  </options>
  <patch id="swtfu2_pad" root="/swtfu2_pad">
    <file disc="main.dol" external="main.dol"/>
  </patch>
  <patch id="swtfu2_tap1">
    <memory offset="0x8071DDB0" value="01" original="00"/>
  </patch>
  <patch id="swtfu2_tap2">
    <memory offset="0x8071DDB1" value="01" original="00"/>
  </patch>
  <patch id="swtfu2_tap3">
    <memory offset="0x8071DDB2" value="01" original="00"/>
  </patch>
  <patch id="swtfu2_tap4">
    <memory offset="0x8071DDB3" value="01" original="00"/>
  </patch>
</wiidisc>
